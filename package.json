{
  "name": "radiochron",
  "version": "0.7.0",
  "description": "Cross-platform Node.js API and streams for RadioChron Wi-Fi flight recording, incident diagnosis, and portable BLE history/risk analysis.",
  "main": "core.js",
  "module": "core.mjs",
  "types": "core.d.ts",
  "exports": {
    ".": { "types": "./core.d.ts", "import": "./core.mjs", "require": "./core.js", "default": "./core.js" },
    "./core": { "types": "./core.d.ts", "import": "./core.mjs", "require": "./core.js", "default": "./core.js" },
    "./wifi": { "types": "./wifi.d.ts", "import": "./wifi.mjs", "require": "./wifi.js", "default": "./wifi.js" },
    "./ble": { "types": "./ble.d.ts", "import": "./ble.mjs", "require": "./ble.js", "default": "./ble.js" },
    "./chronicle": { "types": "./chronicle.d.ts", "import": "./chronicle.mjs", "require": "./chronicle.js", "default": "./chronicle.js" },
    "./package.json": "./package.json"
  },
  "bin": { "radiochron-js": "./cli.js" },
  "files": [
    "core.js",
    "core.mjs",
    "core.d.ts",
    "streams.js",
    "wifi.js",
    "wifi.mjs",
    "wifi.d.ts",
    "ble.js",
    "ble.mjs",
    "ble.d.ts",
    "chronicle.js",
    "chronicle.mjs",
    "chronicle.d.ts",
    "cli.js",
    "cli-render.js",
    "incident-bundle.js",
    "native/radiochron-node-bridge/Cargo.lock",
    "native/radiochron-node-bridge/Cargo.toml",
    "native/radiochron-node-bridge/src",
    "vendor-core",
    "README.md",
    "LICENSE-MIT"
  ],
  "scripts": {
    "test": "node --test",
    "build:core": "node scripts/build-core.js",
    "verify:package": "node scripts/verify-package.js",
    "prepack": "node prepare.js"
  },
  "radiochronCore": {
    "version": "0.6.0",
    "gitSha": "0678b73044cbf83446d17a76912dc004af40f08e",
    "repository": "https://github.com/sergii-ziborov/radiochron"
  },
  "license": "MIT",
  "author": "Sergii Ziborov",
  "homepage": "https://radiochron.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergii-ziborov/radiochron-js.git"
  },
  "bugs": { "url": "https://github.com/sergii-ziborov/radiochron-js/issues" },
  "keywords": ["wifi", "bluetooth", "ble", "diagnostics", "iot", "nodejs", "windows", "linux", "linux-arm64", "raspberry-pi", "macos", "apple-silicon", "rust"],
  "engines": { "node": ">=18" }
}
