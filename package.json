{
  "name": "radiochron",
  "version": "0.6.0",
  "description": "Cross-platform Node.js API and streams for RadioChron Wi-Fi diagnostics and portable BLE history/risk analysis.",
  "main": "core.js",
  "module": "core.mjs",
  "types": "core.d.ts",
  "exports": {
    ".": { "types": "./core.d.ts", "import": "./core.mjs", "require": "./core.js", "default": "./core.js" },
    "./core": { "types": "./core.d.ts", "import": "./core.mjs", "require": "./core.js", "default": "./core.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "core.js",
    "core.mjs",
    "core.d.ts",
    "streams.js",
    "native/radiochron-node-bridge/Cargo.lock",
    "native/radiochron-node-bridge/Cargo.toml",
    "native/radiochron-node-bridge/src",
    "vendor-core",
    "README.md",
    "LICENSE-MIT"
  ],
  "scripts": {
    "test": "node --test",
    "build:core": "node scripts/build-core.js",
    "verify:package": "node scripts/verify-package.js",
    "prepack": "node prepare.js"
  },
  "radiochronCore": {
    "version": "0.5.0",
    "gitSha": "517ffe913eb0076687f72d1f4963e4ce2bf6173a",
    "repository": "https://github.com/sergii-ziborov/radiochron"
  },
  "license": "MIT",
  "author": "Sergii Ziborov",
  "homepage": "https://radiochron.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergii-ziborov/radiochron-js.git"
  },
  "bugs": { "url": "https://github.com/sergii-ziborov/radiochron-js/issues" },
  "keywords": ["wifi", "bluetooth", "ble", "diagnostics", "iot", "nodejs", "windows", "linux", "linux-arm64", "raspberry-pi", "macos", "apple-silicon", "rust"],
  "engines": { "node": ">=18" }
}
